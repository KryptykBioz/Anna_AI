# =============================================================================
# Anna AI - Environment Override Template
# =============================================================================
# Copy this file to .env at the project root and uncomment/set values.
# All values here override personality/config.json defaults.
# Installed tool controls (USE_*) are dynamically created and not listed here.
#
# Convention: AGENT_<SECTION>_<KEY>
# Ollama also accepts legacy OLLAMA_<KEY> for backward compatibility.
# =============================================================================

# =============================================================================
# HISTORY LIMIT                        Single override for all history lengths
# =============================================================================
# Sets conversation history, thought chain length, and context buffer size.
# Overrides all individual history-length fields below unless they are also set.
# Default: 50

# AGENT_HISTORY_LIMIT=50

# =============================================================================
# BOT IDENTITY                                         [config.json: bot.*]
# =============================================================================

# AGENT_BOT_NAME=Anna
# AGENT_BOT_USERNAME=Bioz
# AGENT_BOT_GAME_USERNAME=Player
# AGENT_BOT_GROUP_CHAT_PORT=54321
# AGENT_BOT_MAX_CONTEXT_ENTRIES=25
# AGENT_BOT_RECENT_CONVO_LIMIT=25


# =============================================================================
# MODELS                                               [config.json: models.*]
# =============================================================================

# AGENT_MODELS_THOUGHT_MODEL=gemma3:12b-it-q4_K_M
# AGENT_MODELS_RESPONSE_MODEL=gemma3:12b-it-q4_K_M
# AGENT_MODELS_VISION_MODEL=gemma3:12b-it-q4_K_M
# AGENT_MODELS_EMBED_MODEL=nomic-embed-text:latest
# AGENT_MODELS_TOOL_MODEL=gemma3:12b-it-q4_K_M
# AGENT_MODELS_ACTION_MODEL=gemma3:12b-it-q4_K_M


# =============================================================================
# VOICE                                                [config.json: voice.*]
# =============================================================================

# AGENT_VOICE_VOICE_INDEX=1
# AGENT_VOICE_VB_CABLE_NAME=CABLE Input

# Override voice sample filename for TTS (XTTS). File must exist in personality/voice/.
# Supports .mp3 and .wav. When unset, defaults to <agentname>_voice_sample.mp3
# AGENT_VOICE_VOICE_SAMPLE_FILENAME=anna_voice_sample.mp3

# Override voice sample filename for speaker verification (Whisper). File must exist in personality/voice/.
# When unset, defaults to <username>_voice_sample.mp3
# AGENT_VOICE_USER_VOICE_SAMPLE_FILENAME=user_voice_sample.mp3

# XTTS inference parameters
# AGENT_VOICE_XTTS_LANGUAGE=en
# AGENT_VOICE_XTTS_SPEED=1.0
# AGENT_VOICE_XTTS_TEMPERATURE=0.7
# AGENT_VOICE_XTTS_LENGTH_PENALTY=1.0
# AGENT_VOICE_XTTS_REPETITION_PENALTY=5.0
# AGENT_VOICE_XTTS_TOP_K=50
# AGENT_VOICE_XTTS_TOP_P=0.85
# AGENT_VOICE_XTTS_GPT_COND_LEN=30
# AGENT_VOICE_XTTS_GPT_COND_CHUNK_LEN=4
# AGENT_VOICE_XTTS_MAX_REF_LENGTH=60


