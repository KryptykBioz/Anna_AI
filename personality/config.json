{
  "_comment_architecture": "Configuration file for Anna AI Agent - Dynamic tool system",
  "ollama": {
    "_comment": "Ollama LLM API configuration",
    "endpoint": "http://localhost:11434",
    "temperature": 0.85,
    "temperature_action": 0.2,
    "temperature_cognitive": 0.7,
    "temperature_response": 0.9,
    "max_tokens": 1000,
    "num_predict": 1000,
    "num_ctx": 3000,
    "top_p": 0.92,
    "top_k": 60,
    "repeat_penalty": 1.4,
    "timeout": 600,
    "seed": null
  },
  "models": {
    "_comment": "Model assignments - should match bot_info.py",
    "thought_model": "gemma3:12b-it-q4_K_M",
    "response_model": "gemma3:12b-it-q4_K_M",
    "vision_model": "gemma3:12b-it-q4_K_M",
    "embed_model": "nomic-embed-text",
    "tool_model": "gemma3:12b-it-q4_K_M"
  },
  "bot": {
    "_comment": "Bot identity - should match bot_info.py",
    "name": "Anna",
    "username": "User",
    "max_context_entries": 25,
    "recent_convo_limit": 25
  },
  "memory": {
    "_comment": "Memory system configuration",
    "max_context_entries": 25,
    "embedding_search_results": 1,
    "base_memory_search_results": 1,
    "auto_summarize_threshold": 50,
    "include_base_memory": false
  },
  "logging": {
    "_comment": "Default logging settings - can be overridden in controls.py",
    "log_tool_execution": true,
    "log_prompt_construction": true,
    "log_response_processing": true,
    "log_system_information": true,
    "show_chat": true
  },
  "warudo": {
    "_comment": "Warudo VTuber integration - external tool",
    "websocket_url": "ws://127.0.0.1:19190",
    "enabled": true,
    "auto_connect": true,
    "connection_timeout": 2.0
  },
  "chat_engagement": {
    "_comment": "Autonomous chat engagement system",
    "enabled": false,
    "autonomous": true,
    "check_interval": 30,
    "max_unengaged_messages": 5,
    "engagement_cooldown": 60
  },
  "youtube": {
    "_comment": "YouTube live chat integration - external tool",
    "_note": "Control via USE_YOUTUBE in controls.py (dynamically created)",
    "enabled": true,
    "video_id": "",
    "auto_start": false,
    "max_messages": 10
  },
  "twitch": {
    "_comment": "Twitch chat integration - external tool",
    "_note": "Control via USE_TWITCH in controls.py (dynamically created)",
    "enabled": true,
    "channel": "",
    "auto_start": false,
    "max_messages": 10,
    "oauth_token": "",
    "nickname": ""
  },
  "discord": {
    "_comment": "Discord bot integration - external tool",
    "_note": "Control via USE_DISCORD in controls.py (dynamically created)",
    "enabled": true,
    "bot_token": "",
    "command_prefix": "!",
    "auto_start": false,
    "allowed_channels": [],
    "allowed_guilds": [],
    "respond_to_mentions": true,
    "respond_to_replies": true,
    "respond_to_dms": true,
    "respond_in_threads": true,
    "typing_indicator": true,
    "message_history_limit": 10,
    "max_message_length": 2000,
    "split_long_messages": true,
    "command_cooldown": 3
  },
  "features": {
    "_comment": "Feature toggles - some controlled via dynamic tool system",
    "_note_tts": "TTS selection via USE_GPT_SOVITS, USE_XTTS, USE_PYTTSX3 (dynamic)",
    "_note_voice": "Voice input via USE_SILERO_VAD, USE_WHISPER, USE_VOSK (dynamic)",
    "_note_search": "Search via USE_WEB_SEARCH (dynamically created from tool)",
    "use_search": false,
    "use_vision": false,
    "use_warudo": true,
    "use_sound_effects": true,
    "sound_effects_directory": "./BASE/tools/installed/sound_effects/effects"
  },
  "hot_reload": {
    "_comment": "Hot reload system for development",
    "enabled": true,
    "file_watching": false,
    "debounce_seconds": 2.0,
    "watch_directories": [
      "tools/",
      "BASE/core/"
    ]
  },
  "_architecture_notes": {
    "dynamic_tools": "Tool controls (USE_*) created from information.json files",
    "internal_tools": "BASE/tools/internal/ - TTS, voice input (mutual exclusivity)",
    "external_tools": "BASE/tools/installed/ - Integrations, search, etc.",
    "initialization": "Run dynamic_control_initializer BEFORE GUI startup",
    "priority_system": "Highest priority tool in each service_type enabled by default",
    "mutual_exclusivity": "Only one TTS, one voice_input active at a time",
    "gui_discovery": "GUI automatically discovers and displays all tools"
  }
}