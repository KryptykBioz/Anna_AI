{
  "tool_name": "pyttsx3",
  "tool_description": "Fast system voice synthesis using OS speech engine",
  "category": "internal",
  "service_type": "tts",
  "control_variable_name": "USE_PYTTSX3",
  "control_logic": "enabled_when_true",
  "version": "1.0.0",
  "priority": 5,
  "requirements": {
